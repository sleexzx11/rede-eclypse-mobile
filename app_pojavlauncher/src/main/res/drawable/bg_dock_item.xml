<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#4D8B5CF6" />
            <stroke
                android:width="1.5dp"
                android:color="@color/eclypse_purple_glow" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/eclypse_glass_pill" />
            <stroke
                android:width="1dp"
                android:color="@color/eclypse_glass_stroke" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>
